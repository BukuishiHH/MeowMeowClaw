# 模型名称
model=deepseek-chat

# 模型密钥: ${VAR} 会被 dotenv 展开成环境变量;
api_key=${DEEPSEEK_API_KEY}

# 模型路由(任何 OpenAI 兼容服务: OpenAI / DeepSeek / 通义 / vLLM / Ollama ...)
base_url=https://api.deepseek.com

# 工作目录:
#   留空 或 写 .  -> 预设路径 <项目根>/workspace(与 backend/ 同级)
#   相对路径      -> 相对项目根解析(不随当前工作目录漂移)
#   绝对路径      -> 原样使用
workspace=workspace

# Agent 单轮最大迭代次数(模型 <-> 工具 往返上限); 非法值会回退默认 32
max_iterations=32

# 人设文件: 优先 workspace/identity_file, 缺失时兜底 backend/identity_file
identity_file=identity.md
