# 模型名称
model=deepseek-flash

# 模型密钥: ${VAR} 会被 dotenv 展开成环境变量;
api_key=${DEEPSEEK_API_KEY}

# 模型路由(任何 OpenAI 兼容服务: OpenAI / DeepSeek / 通义 / vLLM / Ollama ...)
base_url=https://api.deepseek.com

# 工作目录:
#   留空 或 写 .  -> 预设路径 <项目根>/workspace(与 meowmeowclaw/ 同级)
#   相对路径      -> 相对项目根解析(不随当前工作目录漂移)
#   绝对路径      -> 原样使用
workspace=workspace

# Agent 单轮最大迭代次数(模型 <-> 工具 往返上限); 非法值会回退默认 32
max_iterations=32

# 记忆存储目录:
#   留空        -> <workspace>/memory(随 workspace 迁移)
#   相对路径    -> 相对项目根解析
#   绝对路径    -> 原样使用
memory_dir=

# 装载会话历史的窗口上限(轮数 / 字符); 非法或 <=0 回退默认
# 历史装载窗口: 50 轮 / 120k 字符(120k 中文字符≈60k token, 使 48000 预算下的 L1 摘要可达)
memory_max_turns=50
memory_max_chars=120000

# ================= 会话运行时缓存(A+ A4/A5) =================
# 内存中缓存的会话运行时(AgentLoop + 串行锁)上限; <=0 视为不限制
# 超过上限时按 LRU 淘汰"空闲"会话(在途 turn 永不淘汰, refcount 归零后释放)
memory_max_cached_sessions=256

# 空闲运行时自动淘汰秒数; 0 = 关闭自动 TTL(仅容量 LRU + 显式清理)
# 淘汰只丢进程内护栏/摘要缓存, JSONL 事实源与下次装载不受影响
memory_cache_idle_seconds=0

# ================= 子代理(SA1: 默认关闭) =================
# 总开关; false 时不注册 spawn_subagent 工具, 行为与现状逐字节一致
subagent_enabled=false

# 总层数(含主代理): 3 = 主代理 + 2 层子代理; depth 2 不提供 spawn_subagent
subagent_max_depth=3

# 子代理模型; 留空继承主 model
subagent_model=

# 子代理单轮最大"模型<->工具"往返次数
subagent_max_iterations=8

# 单个子代理整体超时(秒, 含工具执行)
subagent_timeout_seconds=120

# 单个父代理每轮最多 spawn 的直接子代理数 / 一棵 root turn 下子代理总数上限
subagent_max_children_per_turn=3
subagent_max_total_per_turn=6

# 返回给父代理的 JSON 摘要最大字符数(超出优先截断 summary)
subagent_result_max_chars=8000

# 子代理工具白名单(spawn_subagent 不在此列, 由深度自动决定);
# 默认允许 write_file/exec; 如需只读子代理可删掉这两个
subagent_tools=read_file,list_dir,web_search,web_fetch,load_skill,write_file,exec

# exec 安全档位: guarded(默认) | allowlist; sandbox 预留(未实现时回退 guarded)
subagent_exec_policy=guarded
# allowlist 模式的前缀列表(逗号分隔), 如: pytest -q,ruff check,ls,cat
subagent_exec_allowlist=
# 额外放行的环境变量名(逗号分隔); PATH/HOME/TMPDIR/LANG 等基础变量始终保留
subagent_exec_env_allowlist=

# 子代理覆盖已存在文件前必须 read 并做 sha256 冲突校验
subagent_write_requires_read=true
# 子代理读/写拒绝名单(相对工作区匹配)
subagent_sensitive_paths=.env,*.pem,*.key,id_rsa*,.git/config

# 子代理审计(写 <memory_dir>/subagents/audit.jsonl, 对模型工具不可见)
subagent_audit_enabled=true
subagent_audit_max_bytes=4194304

# 工作区变更锁(仅 subagent_enabled=true 时装配; 主/子代理的 write/exec 都遵守)
workspace_mutation_lock_enabled=true
workspace_mutation_lock_timeout=90

# ================= 上下文 token 压缩 =================
# 总开关; false 时完全退回现状(只按 memory_max_turns/chars 装载历史, 不估算/不压缩)
compression_enabled=true

# 输入 token 预算(估算值 × 1.1 后与此比较触发压缩);
# 默认基于 deepseek-chat 64K 窗口, 预留约 16K 给输出与估算误差; 换模型请同步调整
token_budget=48000

# 分词器: auto | heuristic | tiktoken | tiktoken:<encoding> | hf
#   auto  : OpenAI 系模型优先 tiktoken; 否则找本地 tokenizer.json; 都没有则启发式
#   hf    : 使用 tokenizer.json(需安装可选依赖: pip install "meowmeowclaw[tokenizers]")
tokenizer=auto

# 本地 tokenizer.json 覆盖路径; 留空则依次查找
#   1) <项目根>/tokenizers/<模型名净化>/tokenizer.json
#   2) <项目根>/tokenizers/<模型名净化>.json
# 相对路径按项目根解析; 项目内已有 tokenizers/deepseek-flash/tokenizer.json
# 目录名 = 模型名净化结果(连字符保留): model=deepseek-flash -> tokenizers/deepseek-flash/
# 例如: hf_tokenizer_path=tokenizers/deepseek-flash/tokenizer.json
hf_tokenizer_path=

# 摘要时至少保留原文的最近完整轮数(下限 1); 当前提问与当前轮永不压缩
keep_recent_turns=2

# 摘要模型(留空 = 使用主 model)
summary_model=

# 摘要输出上限(token)与超时(秒); 摘要失败会降级为硬裁剪, 不阻塞回复
summary_max_tokens=768
summary_timeout=15

# HISTORY.md 审计日志: 轮转阈值(字节) / 单条记录原文上限(字符)
history_log_max_bytes=2097152
history_log_original_chars=32000

# ================= 多渠道网关 =================
# 总开关; false 时完全不构造 Gateway, 交付层行为与旧直连路径一致
# true 时 CLI/QQ 经 asyncio.Queue 总线(进程重启后生效)
# QQ 渠道(python -m meowmeowclaw.qq)必须为 true
gateway_enabled=false

# 每个队列(inbound / outbound:<channel> / deadletter)容量; publish 超时进死信
gateway_bus_maxsize=1000

# publish 背压等待秒数
gateway_publish_timeout=5

# 优雅关闭等待秒数(排空 dispatcher/in-flight/出站队列)
gateway_shutdown_timeout=10

# ============ QQ 渠道(NapCat / OneBot 11) ============
# 仅响应 qq_owner_id 的私聊; 其他人/群聊消息一律忽略
qq_owner_id=

# 连接方向:
#   reverse(推荐) 本进程监听 WS, NapCat 作为客户端连入并自动重连
#   forward       本进程作为客户端连接 NapCat 的 WS 服务端(内置指数退避重连)
qq_ws_mode=reverse

# reverse: 监听地址(NapCat 连入的目标); forward: 要连接的 NapCat 地址
qq_ws_host=127.0.0.1

# reverse: 监听端口; forward: NapCat "WebSocket 服务器" 的端口
qq_ws_port=3100

# WS 路径(reverse/forward 通用)
qq_ws_path=/onebot/v11/ws

# 访问令牌: 与 NapCat「网络配置」里的 Token 保持一致; 留空则不校验(不建议)
qq_token=

# 单次 OneBot 动作(发送消息)等待响应的超时秒数
qq_action_timeout=10

# 单条 QQ 消息的字符上限, 超长回复自动分片发送
qq_message_chunk_chars=3000

# ============ 流式输出(设计见 docs/STREAMING_DESIGN.md) ============
# 总开关; false(默认) 时完全走非流式路径, 行为与旧版一致
stream_enabled=false

# CLI 逐字输出(需 stream_enabled=true)
cli_stream=true

# QQ 呈现档位:
#   off    完全不处理流式(等价旧行为)
#   typing 仅显示"对方正在输入", 结束后只发 1 条完整气泡(推荐)
#   block  段落级流式(2~5 条气泡), 计划 S5 实现, 当前按 typing 处理
qq_stream_mode=typing

# "正在输入"指示器开关与续期间隔(秒); 依赖 NapCat 扩展接口 set_input_status
qq_typing_indicator=true
qq_typing_refresh_seconds=5

# ---- block 分段呈现参数(仅 qq_stream_mode=block 生效; S5.1 修订) ----
# 块大小三档: 下限 / 理想值 / 硬上限(单位: 字符)
#   - 每块保证 >= min_chars; 同级边界里取最接近 target 的; 绝不越过 max_block
#   - 600~700 字的回答 => 约 4~5 条大小接近的气泡
qq_stream_first_chars=150       # 首块触发下限(默认=target; 调小可更早看到首块, 但首块会偏小)
qq_stream_min_chars=80          # 单块下限
qq_stream_target_chars=150      # 理想块大小
qq_stream_max_block_chars=260   # 单块硬上限(找不到边界时也在此处硬切)
# 两条中间气泡的最小间隔(秒): 防风控 + 防刷屏
qq_stream_min_interval=2.5
# 单轮总气泡上限(含收尾补发; 超出后剩余内容并入最后一条)
qq_stream_max_messages=5
# 收尾补发块之间的间隔(秒), 避免"最后一口气发好几条"触发风控; 0=不等待
qq_stream_flush_interval=0.3
# 已废弃: 旧键 qq_stream_hard_chars 仍可作为 qq_stream_max_block_chars 的别名使用

# 工具轮"前导文本"抑制: 缓冲 + 宽限窗口内未出现 tool_calls 才外发
# false = 过程旁白也发(调试用)
stream_suppress_tool_preamble=true
stream_preamble_grace_ms=1500
stream_preamble_grace_chars=40
